{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "HiveVoice",
  "version": "0.1.0",
  "identifier": "app.hivevoice.desktop",
  "build": {
    "frontendDist": "https://hive-voice.vercel.app"
  },
  "app": {
    "windows": [
      {
        "title": "HiveVoice",
        "url": "https://hive-voice.vercel.app/friends",
        "width": 1200,
        "height": 800,
        "minWidth": 360,
        "minHeight": 500,
        "backgroundColor": "#f4f4f4"
      }
    ],
    "security": {
      "csp": null
    },
    "withGlobalTauri": true
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "SocialNetworking",
    "shortDescription": "Anfragen, anbieten, verbinden.",
    "longDescription": "HiveVoice als Desktop-App: ein eigenes Fenster für die Seite hive-voice.vercel.app.",
    "copyright": "HiveVoice",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "linux": {
      "deb": {
        "section": "net"
      }
    },
    "createUpdaterArtifacts": true,
    "macOS": {
      "signingIdentity": "-"
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEYwOTYyQTEwNDkyQjJFOTUKUldTVkxpdEpFQ3FXOEN0d3hUQkNTRDdQQ3BwSVloOVFmOVBYUkFkT25lRnpLY05TNjlYV29sb3AK",
      "endpoints": [
        "https://github.com/dafiiit/HiveVoice/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
