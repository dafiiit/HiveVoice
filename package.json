{
  "name": "hivevoice",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "db:migrate": "node --env-file-if-exists=.env.local scripts/migrate.mjs",
    "db:seed": "node --env-file-if-exists=.env.local scripts/seed.mjs",
    "db:regions": "node --env-file-if-exists=.env.local scripts/import-regions.mjs",
    "messages": "node scripts/messages-index.mjs",
    "db:images": "node --env-file-if-exists=.env.local scripts/upload-demo-images.mjs",
    "screens": "playwright test -c tools/screens/playwright.config.ts",
    "review": "node -e \"require('fs').rmSync('test-results/review',{recursive:true,force:true})\" && playwright test -c tools/review/playwright.config.ts; node tools/review/report.mjs",
    "db:seed:test": "node --env-file-if-exists=.env.local scripts/seed-test.mjs",
    "drawio": "node scripts/drawio.mjs",
    "prebuild": "node scripts/drawio.mjs"
  },
  "dependencies": {
    "@codemirror/commands": "^6.11.1",
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/language": "^6.13.1",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.15",
    "@lezer/common": "^1.5.4",
    "@lezer/markdown": "^1.8.1",
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.117.3",
    "katex": "^0.19.0",
    "maplibre-gl": "^5.24.0",
    "mermaid": "^12.2.0",
    "next": "16.4.1",
    "next-intl": "^4.14.9",
    "postgres": "^3.4.9",
    "qrcode": "^1.5.4",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "server-only": "^0.0.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^24.19.2",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "dotenv": "^18.0.8",
    "eslint": "^9",
    "eslint-config-next": "16.4.1",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^5.0.4"
  }
}
